      "skill": "figure",
      "default": null,
      "doc": "The race of the carved head: a map of african, asian and caucasian to a weight from 0 to 1. None: the person of World."
    },
    {
      "name": "face",
      "type": "skill",
      "skill": "figure",
      "default": {},
      "doc": "The face of the carved head as the sculptor made it: a map of a slider of MakeHuman to a value from -1 to 1."
    },
    {
      "name": "hair",
      "type": "choice",
      "default": "long01",
