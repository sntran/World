// The Worker of https://world.mkfifo.com: the factory of World
// (docs/factory.md). "npm run build" makes site/ (scripts/site.sh) and
// edge.com (scripts/edge.sh), and "wrangler deploy" uploads them. Workers
// Builds runs both at each push to main.
{
  "name": "world",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  // The domain of the site: a custom domain of the Worker (Cloudflare
  // makes its DNS record and its certificate in the zone mkfifo.com).
  "routes": [{ "pattern": "world.mkfifo.com", "custom_domain": true }],
  "workers_dev": false,
  // The static files: the review page and the catalog. They go out
  // before the Worker runs. site/_headers gives CORS and the cache.
  "assets": { "directory": "./site" },
  // edge.com goes into the Worker as bytes.
  "rules": [{ "type": "Data", "globs": ["**/*.com"], "fallthrough": true }],
  // The VM of World runs in the Durable Object Beam (worker.js).
  "durable_objects": { "bindings": [{ "name": "BEAM", "class_name": "Beam" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Beam"] }],
  // The most CPU time of a request (5 minutes; 30 s by default). A part
  // that needs more builds on a native node (World.Labour).
  "limits": { "cpu_ms": 300000 },
  // The orders and the files that the VM built. Make the bucket before
  // the first deploy: npx wrangler r2 bucket create world
  "r2_buckets": [{ "binding": "ORDERS", "bucket_name": "world" }],
  // WORLD_LABOUR=parts: the node gives the large parts to the native nodes
  // that join it, and shares no jobs (World.Labour). DIST_NAME and
  // DIST_LISTEN: the node takes the distributed Erlang of the native
  // nodes, over the link (/.tcp/4370, handler.js). The secrets
  // WORLD_LINK_TOKEN (the token of the link) and DIST_COOKIE (the cookie
  // of the nodes) are not here: npx wrangler secret put NAME.
  // WORLD_SERVER starts the HTTP server of the VM (World.Application).
  // WORLD_LOG_STORE: the port of the log of the node (worker.js,
  // World.Log.Store).
  // WORLD_ORDER_STORE: the port of the store of the orders (worker.js,
  // World.Orders.Store). -Mea min: the smallest allocators, for the
  // 128 MB of an isolate. WORLD_MEMORY_MB: the most memory of
  // WebAssembly of the VM for a build (World.Guard, wasm_host:memory/1):
  // a build that needs more stops with an error, and the VM stays under
  // the 128 MB of its isolate.
  "vars": { "WORLD_SERVER": "true", "WORLD_ORDER_STORE": "/env/ORDER_STORE", "WORLD_LOG_STORE": "/env/LOG_STORE", "WORLD_MEMORY_MB": "118", "BEAM_ERL_FLAGS": "-Mea min", "WORLD_LABOUR": "parts", "DIST_NAME": "world@127.0.0.1", "DIST_LISTEN": "true" },
  // The Preview of a branch that is not main (Workers Builds runs "npx
  // wrangler preview" for it). A Preview does not take the settings
  // above, and Wrangler refuses a Preview with no "previews" block. The
  // Durable Object and its migrations stay above: each Preview gets its
  // own namespace. A Preview uses the bucket of the orders of the site:
  // the key of an order is the hash of its text, so an order has the
  // same key in a Preview and on the site. (A Preview can add to the
  // history of the edits of an order of the site.)
  "previews": {
    "r2_buckets": [{ "binding": "ORDERS", "bucket_name": "world" }],
    "vars": { "WORLD_SERVER": "true", "WORLD_ORDER_STORE": "/env/ORDER_STORE", "WORLD_LOG_STORE": "/env/LOG_STORE", "WORLD_MEMORY_MB": "118", "BEAM_ERL_FLAGS": "-Mea min", "WORLD_LABOUR": "parts", "DIST_NAME": "world@127.0.0.1", "DIST_LISTEN": "true" }
  },
  "observability": { "enabled": true }
}
